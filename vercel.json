{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/app-saude-front-end/browser",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://appsaudeback.onrender.com/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
